{
  "name": "aethershell",
  "productName": "AetherShell",
  "version": "1.14.0",
  "description": "Persistent overlay shell for Windows 10 and 11",
  "author": "AetherShell",
  "license": "MIT",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "build:renderer": "vite build --config vite.config.ts",
    "pack:win": "npm run build:renderer && electron-builder --win zip portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "vite": "^6.3.5",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "desktop.aethershell.app",
    "productName": "AetherShell",
    "copyright": "MIT",
    "directories": {
      "output": "dist-win"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "pty.cjs",
      "dist-renderer/**/*",
      "resources/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "resources/icon.png",
      "target": [
        { "target": "zip", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "electronDownload": {
      "mirror": "https://github.com/electron/electron/releases/download/"
    }
  }
}
